&files
 wffile='stationarity_restart.tdhf'
/
&force
 name='SV-bas', pairing='NONE'
/
&main
 mprint=10, mplot=100000, mrest=500000,
 writeselect='r', imode=2, tfft=T, nof=1
/
&grid
 nx=24, ny=24, nz=24,
 dx=1.0, dy=1.0, dz=1.0,
 periodic=F
/
&dynamic
 nt=250, dt=0.2, mxpact=4,
 texternal=F
/
&fragments
 filename=1*'../static_svbas/mg24_svbas.tdhf',
 fix_boost=T,
 fcent(1,1)=0.0, 0.0, 0.0
/

