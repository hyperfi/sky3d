&files
 wffile='e0_baseline_restart.tdhf'
/
&force
 name='SV-bas', pairing='NONE'
/
&main
 mprint=10, mplot=100000, mrest=2500,
 writeselect='r', imode=2, tfft=T, nof=1
/
&grid
 nx=24, ny=24, nz=24,
 dx=1.0, dy=1.0, dz=1.0,
 periodic=F
/
&dynamic
 nt=10000, dt=0.2, mxpact=4,
 texternal=T
/
&extern
 ipulse=0, isoext=0,
 ampl_ext=5.0D-5,
 L_val=0, M_val=0,
 radext=200.0D0, widext=1.0D0,
 textfield_periodic=F
/
&fragments
 filename=1*'../static_svbas_rotated/mg24_svbas_zaxis.tdhf',
 fix_boost=T,
 fcent(1,1)=0.0, 0.0, 0.0
/

