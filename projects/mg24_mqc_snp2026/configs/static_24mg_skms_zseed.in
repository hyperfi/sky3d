&files
 wffile='mg24_skms_zaxis.tdhf'
/
&force
 name='SkMs', pairing='NONE'
/
&main
 mprint=10, mplot=100000, mrest=200,
 writeselect='r', imode=1, tfft=T, nof=0
/
&grid
 nx=24, ny=24, nz=24,
 dx=1.0, dy=1.0, dz=1.0,
 periodic=F
/
&static
 nprot=12, nneut=12,
 radinx=2.4, radiny=2.4, radinz=5.4,
 x0dmp=0.40, e0dmp=100.0,
 tdiag=T, tlarge=F,
 maxiter=3000, serr=1.0D-6
/
